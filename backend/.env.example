# Local development only. Copy to backend/.env and replace the JWT secret.
# Never commit a real .env. Do not use these values in production.

NODE_ENV=development
PORT=3000
BIND_HOST=127.0.0.1

# Local fixture only. Hosted URLs are not stored here.
# Secret names for a later approved deploy: TRUBER_DATABASE_URL and TRUBER_DATABASE_MIGRATION_URL.
DB_TARGET=local
DB_SCHEMA=public
POSTGIS_SCHEMA=public
DB_SSL_MODE=disable
DB_CONNECTION_MODE=direct
DB_MIGRATION_CONNECTION_MODE=direct
DB_POOL_MAX=10
DATABASE_URL=postgres://truber:truber@127.0.0.1:5432/truber
# DATABASE_MIGRATION_URL defaults to DATABASE_URL for DB_TARGET=local.
# DB_RUNTIME_ROLE is optional locally. Hosted API login uses secret name TRUBER_DB_RUNTIME_ROLE.
# DB_SSL_CA_FILE is required for DB_TARGET=supabase. Mount secret file TRUBER_DB_SSL_CA and point this at the path.
# On Vercel, set DB_SSL_CA to the PEM text instead, DB_CONNECTION_MODE=transaction, and CLIENT_IP_SOURCE=vercel.
# See README "Deploying to Vercel" for the full list of names.

# Required. At least 32 characters. Generate a unique value per environment.
JWT_ACCESS_SECRET=replace-with-a-unique-random-string-at-least-32-characters

# Locked to the published contract. The process refuses other values.
JWT_ACCESS_TTL_SECONDS=1800
RESET_TOKEN_TTL_SECONDS=1800

# Implementation bounds (the contract does not set these).
REFRESH_TTL_SECONDS=1209600
OTP_TTL_SECONDS=600

# dev writes reset tokens and OTP codes to delivery_outbox only.
# disabled stores nothing retrievable and sends nothing.
# NODE_ENV=production refuses DELIVERY_ADAPTER=dev.
DELIVERY_ADAPTER=dev

# Dev-only local demo/evidence fixture for the absent bookings domain.
# JSON array of BookingParties objects, re-read on every request.
# NODE_ENV=production refuses DEV_BOOKING_FIXTURES_FILE.
# DEV_BOOKING_FIXTURES_FILE=/absolute/path/to/booking-fixtures.json

RESET_SOURCE_MAX=10
RESET_SOURCE_WINDOW_SECONDS=600
CONFIRM_SOURCE_MAX=20
CONFIRM_SOURCE_WINDOW_SECONDS=600
OTP_SOURCE_MAX=5
OTP_SOURCE_WINDOW_SECONDS=600
OTP_VERIFY_MAX=5
OTP_VERIFY_WINDOW_SECONDS=600

# Seed is a separate command. It refuses NODE_ENV=production and requires:
#   SEED_CONFIRM=I_UNDERSTAND_THIS_IS_NOT_PRODUCTION
#   SEED_ADMIN_PASSWORD=<min 8 chars, not stored in git>
# SEED_ADMIN_EMAIL=admin@seed.truber.local

# Test environments only. A fixed 6-digit OTP that /auth/otp/verify accepts after
# /auth/otp/request. Refused when NODE_ENV=production or when the database URL
# points at the production Supabase project. Leave unset everywhere else.
# TEST_OTP_CODE=

# Test-environment seed (scripts/seed-test-env.ts, `npm run seed:test`).
# SEED_TEST_ENV=yes
# SEED_API_URL=http://127.0.0.1:3000
