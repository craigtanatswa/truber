# Local development only. Copy to backend/.env and replace the JWT secret.
# Never commit a real .env. Do not use these values in production.

NODE_ENV=development
PORT=3000
BIND_HOST=127.0.0.1
DATABASE_URL=postgres://truber:truber@127.0.0.1:5432/truber

# Required. At least 32 characters. Generate a unique value per environment.
JWT_ACCESS_SECRET=replace-with-a-unique-random-string-at-least-32-characters

# Locked to the published contract. The process refuses other values.
JWT_ACCESS_TTL_SECONDS=900
RESET_TOKEN_TTL_SECONDS=1800

# Implementation bounds (the contract does not set these).
REFRESH_TTL_SECONDS=1209600
OTP_TTL_SECONDS=600

# dev writes reset tokens and OTP codes to delivery_outbox only.
# disabled stores nothing retrievable and sends nothing.
# NODE_ENV=production refuses DELIVERY_ADAPTER=dev.
DELIVERY_ADAPTER=dev

RESET_SOURCE_MAX=10
RESET_SOURCE_WINDOW_SECONDS=600
CONFIRM_SOURCE_MAX=20
CONFIRM_SOURCE_WINDOW_SECONDS=600
OTP_SOURCE_MAX=5
OTP_SOURCE_WINDOW_SECONDS=600
OTP_VERIFY_MAX=5
OTP_VERIFY_WINDOW_SECONDS=600

# Seed is a separate command. It refuses NODE_ENV=production and requires:
#   SEED_CONFIRM=I_UNDERSTAND_THIS_IS_NOT_PRODUCTION
#   SEED_ADMIN_PASSWORD=<min 8 chars, not stored in git>
# SEED_ADMIN_EMAIL=admin@seed.truber.local
