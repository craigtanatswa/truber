{
  "name": "@truber/backend",
  "version": "0.4.0",
  "private": true,
  "description": "Truber auth and loads API (contract v0.4.0 slice)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit --pretty false",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"api/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "jest --runInBand",
    "test:supabase-like": "bash scripts/prepare-local-supabase-like.sh && DB_TARGET=local DB_SCHEMA=truber POSTGIS_SCHEMA=gis DB_RUNTIME_ROLE=truber_runtime DB_SSL_MODE=disable DB_CONNECTION_MODE=direct DB_MIGRATION_CONNECTION_MODE=direct DATABASE_URL=postgres://truber_runtime:truber@127.0.0.1:5432/truber_gis_like DATABASE_MIGRATION_URL=postgres://truber:truber@127.0.0.1:5432/truber_gis_like jest --runInBand",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/seed/seed-dev.ts",
    "seed:test": "tsx scripts/seed-test-env.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
